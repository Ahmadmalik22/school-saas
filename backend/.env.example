# ==========================================
# SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Port for the Node.js Express & Socket.io server
PORT=5000

# Client Web Application URL (for CORS and Socket.io origin validation)
CLIENT_URL=http://localhost:5173

# ==========================================
# DATABASE (MONGODB)
# ==========================================
# MongoDB Connection String (Atlas Free Cluster or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/wholesale_db?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/wholesale_db
MONGO_URI=mongodb://127.0.0.1:27017/wholesale_db

# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
JWT_SECRET=wholesale_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=30d

# ==========================================
# CLOUDINARY (FREE IMAGE STORAGE & WEBP CDN)
# ==========================================
# Find these in your Cloudinary Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
